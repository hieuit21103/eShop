{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "ConnectionStrings": {
    "PgHost": "localhost",
    "PgPort": "5432",
    "PgUsername": "postgres",
    "PgPassword": "123",
    "PgDatabase": "eshop/filestorage_db"
  },
  "S3": {
    "BucketName": "eshop",
    "PresignExpiration": "15",
    "AccessKey": "your_access_key_here",
    "SecretKey": "your_secret_key_here",
    "EndPoint": "s3.amazonaws.com"
  }
}
